export PATH="$HOME/.local/bin:$PATH"

HISTSIZE=10000
HISTFILESIZE=10000
shopt -s histappend

# Cache ble.sh (tput per-$TERM) DIPINDAH keluar dari ~/.cache (tmpfs,
# kehapus tiap reboot) -- tanpa ini, ble.sh regenerate cache "updating
# tput cache... done" tiap kali buka terminal pertama pasca-reboot.
_ble_cache_home_saved="${XDG_CACHE_HOME:-}"
export XDG_CACHE_HOME="$HOME/.local/state/ble-cache"
mkdir -p "$XDG_CACHE_HOME"
[[ $- == *i* ]] && source "$HOME/.local/share/blesh/ble.sh" --noattach
if [ -n "$_ble_cache_home_saved" ]; then
    export XDG_CACHE_HOME="$_ble_cache_home_saved"
else
    unset XDG_CACHE_HOME
fi
unset _ble_cache_home_saved

# --- taruh kustomisasi .bashrc lain di sini kalau ada, SEBELUM baris ble-attach ---

[[ ${BLE_VERSION-} ]] && ble-attach
